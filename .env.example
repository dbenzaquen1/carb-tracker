# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard under: Project Settings -> API.
#
# The anon key is safe to expose in a client app — your data is protected by
# Row Level Security (see supabase/schema.sql).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (PT reminders): the VAPID *public* key. Generate a key pair with
#   npx web-push generate-vapid-keys
# Keep the private key out of the client; it belongs in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=
